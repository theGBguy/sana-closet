---
// Image with reserved space, a soft colour placeholder, a fade-in and a smaller copy for phones.
import { url } from '../lib/data';
import { imgInfo, srcset } from '../lib/img';

interface Props {
  src: string;
  alt?: string;
  sizes?: string;
  eager?: boolean;
  id?: string;
  class?: string;
}
const { src, alt = '', sizes = '100vw', eager = false, id, class: cls } = Astro.props;
const info = await imgInfo(src);
const set = srcset(src, info);
---
<img
  src={url(src)}
  srcset={set}
  sizes={set ? sizes : undefined}
  width={info?.w}
  height={info?.h}
  alt={alt}
  id={id}
  class:list={['pic', cls]}
  style={info ? `background-color:${info.color}` : undefined}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
