---
import Heart from './Heart.astro';
import { url, getPairs, type Product } from '../lib/data';
interface Props { product: Product }
const { product: p } = Astro.props;
const d = p.data;
const pairs = await getPairs(p);
---
<div class="pcard reveal">
  {d.photo ? (
    <div class="ph"><img src={url(d.photo)} alt={d.title} loading="lazy" decoding="async" /></div>
  ) : (
    <div class="ph text"><b>{d.title}</b><span class="label">{d.category}</span></div>
  )}
  <button class="heart" type="button" data-save={`item:${p.id}`} aria-pressed="false" aria-label={`Save ${d.title}`}><Heart /></button>
  <div class="brand">{d.brand}</div>
  <h3>{d.title}</h3>
  <span class="tag" style="align-self:flex-start">{d.price_band}</span>
  <a class="shop" href={d.link} target="_blank" rel="nofollow sponsored noopener" data-out={p.id}>Shop on Amazon ↗</a>
  {pairs.length > 0 && (
    <p class="pairs-line">Pairs with <a href={pairs[0].data.link} target="_blank" rel="nofollow sponsored noopener">{pairs[0].data.title} ↗</a>{pairs.length > 1 && <span> +{pairs.length - 1}</span>}</p>
  )}
</div>
